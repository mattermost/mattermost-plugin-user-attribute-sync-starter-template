{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": "off",
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "@typescript-eslint/no-non-null-assertion": "off"
  },
  "ignorePatterns": ["node_modules/", "test-results/", "playwright-report/"]
}
